datadir="/var/lib/proxysql"

admin_variables=
{
  admin_credentials="admin:admin;radmin:radmin"
  mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
  threads=4
  max_connections=2048          # Lab #10: this is the total pool ProxySQL maintains
  default_query_delay=0
  default_query_timeout=36000000
  have_compress=true
  poll_timeout=2000
  interfaces="0.0.0.0:6033"
  default_schema="scalabilitylab"
  stacksize=1048576
  server_version="8.0.36"
  connect_timeout_server=3000
  monitor_username="proxysql_monitor"
  monitor_password="monitor_pass"
  monitor_connect_interval=200000
  monitor_ping_interval=200000
  ping_interval_server_msec=120000
  ping_timeout_server=500
  commands_stats=true
  sessions_sort=true
  connect_retries_on_failure=10
}

mysql_servers =
(
  { address="mysql-primary" , port=3306 , hostgroup=0, max_connections=100 },
  { address="mysql-replica" , port=3306 , hostgroup=1, max_connections=200 }
)

mysql_users =
(
  { username="root" , password="root" , default_hostgroup=0 , active=1 }
)

# Route read-only queries to replica (hostgroup 1)
mysql_query_rules =
(
  { rule_id=1 , active=1 , match_pattern="^SELECT.*FOR UPDATE$" , destination_hostgroup=0 , apply=1 },
  { rule_id=2 , active=1 , match_pattern="^SELECT"              , destination_hostgroup=1 , apply=1 }
)
